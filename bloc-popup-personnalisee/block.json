{
  "apiVersion": 3,
  "name": "mon-namespace/mon-bloc",
  "title": "Block with Custom Popup",
  "category": "common",
  "icon": "admin-links",
  "description": "A block with 5 links and customizable popup",
  "keywords": ["links", "popup", "external"],
  "supports": {
    "html": false
  },
  "attributes": {
    "popupTitle": {
      "type": "string",
      "default": ""
    },
    "popupDescription": {
      "type": "string",
      "default": ""
    },
    "titleWasTruncated": {
      "type": "boolean",
      "default": false
    },
    "descriptionWasTruncated": {
      "type": "boolean",
      "default": false
    },
    "links": {
      "type": "array",
      "default": [
        { "id": 1, "url": "", "text": "Link 1", "useCustomPopup": false },
        { "id": 2, "url": "", "text": "Link 2", "useCustomPopup": false },
        { "id": 3, "url": "", "text": "Link 3", "useCustomPopup": false },
        { "id": 4, "url": "", "text": "Link 4", "useCustomPopup": false },
        { "id": 5, "url": "", "text": "Link 5", "useCustomPopup": false }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
